// BitonicPixelSorter.usf
// Unreal Engine port of ruccho/BitonicPixelSorter (MIT, Copyright (c) 2020 ruccho).
//
// Faithful port of BitonicPixelSorter.compute, generalized to arbitrary-angle sort lines.
// Differences vs the original:
//   - Unity "#pragma kernel" / debug pragmas removed (entry points wired in C++ via IMPLEMENT_GLOBAL_SHADER).
//   - `min16int` -> `int` (avoided for cross-platform/Metal safety).
//   - `bool` shader params arrive as uint (direction / ordering).
//   - Confined to ViewRect via viewportMin / viewportSize.
//   - Arbitrary angle: instead of axis-aligned rows/columns, each "line" is a sheared digital line
//     pixel = (coord, round(L + coord*slope)) (x-major) at angle theta. Because round(n + f) == n +
//     round(f) for integer n, the forward map is an exact tiling of the grid -> the result is an
//     exact permutation of in-view pixels (no resampling/blur). slope == 0 reproduces the original
//     axis-aligned rows/columns bit-for-bit. See lineTexel().
// Loose parameter names must match the C++ SHADER_PARAMETER_STRUCTs (FMetaPassCS / FSortPassCS).

#include "/Engine/Public/Platform.ush"

#define MAX_TGSM 8192 // 32KiB / 32bit
#define MAX_THREADS 256
#define MAX_SIZE 2048 // due to group shared memory limit

#define MAX_OPS (MAX_SIZE / MAX_THREADS)

#define META_LINES_PER_GROUP 8
#define META_THREADS_PER_GROUP (META_LINES_PER_GROUP * 2)

float brightness(float4 col)
{
    return saturate(0.298912 * col.r + 0.586611 * col.g + 0.114478 * col.b);
}

uint packMetaGroupCache(bool left, bool right, int value, int brightnessA, int brightnessB)
{
    // lrvvvvvv vvvvvvvv bbbbbbbb BBBBBBBB
    uint packed = left ? 0x80000000 : 0;
    packed |= right ? 0x40000000 : 0;
    packed |= (asuint(value) & 0x3FFF) << 16; // lower 14bit
    packed |= (brightnessA & 0xFF) << 8;
    packed |= (brightnessB & 0xFF);
    return packed;
}

void unpackMetaGroupCache(uint packed, out bool left, out bool right, out int value, out int brightnessA,
                          out int brightnessB)
{
    left = (packed & 0x80000000) != 0;
    right = (packed & 0x40000000) != 0;

    uint valueSeg = packed >> 16 & 0x3FFF; //lower 14bit
    bool isNegative = (valueSeg & 0x2000) != 0; // sign
    valueSeg |= isNegative ? 0xFFFFC000 : 0;
    value = asint(valueSeg);

    brightnessA = (packed & 0x0000FF00) >> 8;
    brightnessB = (packed & 0x000000FF);
}

// ============================ shared parameters ============================
// Match FMetaPassCS::FParameters / FSortPassCS::FParameters.
Texture2D<float4> srcTex;
RWTexture2D<uint2> metaTex;
float thresholdMin;
float thresholdMax;
uint direction;      // 1 = x-major (lines run along X, ~horizontal), 0 = y-major (along Y, ~vertical)
uint2 viewportMin;   // ViewRect.Min: texel offset of the view inside the (often padded) texture
uint2 viewportSize;  // ViewRect size: process only this region (texels outside are uninitialized)
float slope;         // minor-axis step per major-axis step (tan or cot, in [-1,1]); 0 = axis-aligned
int lineOffset;      // line intercept of lineIdx 0 (L = lineIdx + lineOffset)

// Map (line index, position along the major axis) to a texel in the view.
//   minor = round((lineIdx + lineOffset) + coord*slope)
// bInside is false when the texel leaves the view along the minor axis (those positions are skipped:
// not range-tested and not written), keeping the operation an exact permutation of in-view pixels.
// slope == 0 collapses to the original axis-aligned mapping (coord, lineIdx) / (lineIdx, coord).
uint2 lineTexel(int lineIdx, int coord, out bool bInside)
{
    int minorDim = direction ? (int)viewportSize.y : (int)viewportSize.x;
    int minor = (int)round((float)(lineIdx + lineOffset) + (float)coord * slope);
    bInside = (minor >= 0) && (minor < minorDim);
    int minorC = clamp(minor, 0, minorDim - 1); // keep the texel read in-bounds even when skipped
    return direction ? uint2((uint)coord, (uint)minorC) : uint2((uint)minorC, (uint)coord);
}

// ============================ MetaPass ============================
groupshared uint metaGroupCache[MAX_SIZE * 4];

[numthreads(META_THREADS_PER_GROUP,1,1)]
void MetaPass(uint3 groupId : SV_GroupID,
              uint3 gtid : SV_GroupThreadID)
{
    uint width = viewportSize.x;
    uint height = viewportSize.y;

    uint size = direction ? width : height; // line length along the major axis
    uint id = groupId.x * META_THREADS_PER_GROUP + gtid.x;
    bool metaDirection = id % 2 == 0; // RTL for even thread, LTR for odd thread
    uint y = id / 2; // line index (two threads per line)
    uint groupLocalY = gtid.x / 2;

    // NOTE: do not early-out excess threads (y >= numLines) here -- the group barrier below must be
    // reached by every thread. Excess threads harmlessly process an all-out-of-view line; their
    // metaTex writes land out of bounds (row >= numLines) and are dropped.

    int rangeStart = metaDirection ? size : -1;
    uint halfSize = round(size / 8) * 4;

    uint firstHalfSize = metaDirection ? halfSize : (size - halfSize);
    uint cacheLineSize = ceil(size / 2.0);

    {
        for (uint p = 0; p < firstHalfSize; p += 2)
        {
            uint x = metaDirection ? p : (size - p - 1);

            uint xMeta = x / 2;
            uint xL = xMeta << 1;
            uint xR = xL + 1;
            uint xFirst = metaDirection ? xL : xR;
            uint xSecond = metaDirection ? xR : xL;

            bool inFirst, inSecond;
            uint2 posFirst = lineTexel((int)y, (int)xFirst, inFirst);
            uint2 posSecond = lineTexel((int)y, (int)xSecond, inSecond);

            float bFirst = brightness(srcTex[posFirst + viewportMin]);
            bool rangeFirst = xFirst < size && inFirst && thresholdMin <= bFirst && bFirst <= thresholdMax;

            float bSecond = brightness(srcTex[posSecond + viewportMin]);
            bool rangeSecond = inSecond && thresholdMin <= bSecond && bSecond <= thresholdMax;

            int rangeStartFirst = metaDirection
                                      ? (rangeFirst ? min(rangeStart, (int)xFirst) : size)
                                      : (rangeFirst ? max(rangeStart, (int)xFirst) : -1);

            rangeStart = metaDirection
                             ? (rangeSecond ? min(rangeStartFirst, (int)xSecond) : size)
                             : (rangeSecond ? max(rangeStartFirst, (int)xSecond) : -1);

            int rangeStartAny = rangeFirst ? rangeStartFirst : rangeStart;

            uint cachePos = groupLocalY * cacheLineSize + xMeta;
            bool rangeLeft = metaDirection ? rangeFirst : rangeSecond;
            bool rangeRight = metaDirection ? rangeSecond : rangeFirst;

            uint bLeft = metaDirection ? bFirst * 255 : bSecond * 255;
            uint bRight = metaDirection ? bSecond * 255 : bFirst * 255;

            uint packedCache = packMetaGroupCache(rangeLeft, rangeRight, rangeStartAny, bLeft, bRight);

            metaGroupCache[cachePos] = packedCache;
        }
    }

    GroupMemoryBarrierWithGroupSync();

    {
        for (uint p = firstHalfSize; p < size; p += 2)
        {
            uint x = metaDirection ? p : (size - p - 1);

            uint xMeta = x / 2;
            uint xL = xMeta << 1;
            uint xR = xL + 1;
            uint xFirst = metaDirection ? xL : xR;
            uint xSecond = metaDirection ? xR : xL;

            uint cachePos = groupLocalY * cacheLineSize + xMeta;
            uint packed = metaGroupCache[cachePos];

            bool rangeLeft;
            bool rangeRight;
            int otherStart;
            int bFirst;
            int bSecond;

            unpackMetaGroupCache(packed, rangeLeft, rangeRight, otherStart, bFirst, bSecond);

            bool rangeFirst = metaDirection ? rangeLeft : rangeRight;
            bool rangeSecond = metaDirection ? rangeRight : rangeLeft;

            int rangeStartFirst = metaDirection
                                      ? (rangeFirst ? min(rangeStart, (int)xFirst) : size)
                                      : (rangeFirst ? max(rangeStart, (int)xFirst) : -1);

            rangeStart = metaDirection
                             ? (rangeSecond ? min(rangeStartFirst, (int)xSecond) : size)
                             : (rangeSecond ? max(rangeStartFirst, (int)xSecond) : -1);

            int rangeStartAny = rangeFirst ? rangeStartFirst : rangeStart;

            float startL = metaDirection ? rangeStartAny : otherStart;
            float startR = metaDirection ? otherStart : rangeStartAny;

            // metaTex is our own intermediate, keyed by (position/2 along the line, line index).
            // B8L12R12
            metaTex[uint2(xMeta, y)] = uint2(((uint)startL & 0x0FFF) << 12 | (uint)startR & 0x0FFF,
                                             ((f32tof16(bFirst) & 0xFFFF) << 16) | (f32tof16(bSecond) & 0xFFFF));
        }
    }
}

// ============================ SortPass ============================
Texture2D<uint2> srcMetaTex;
RWTexture2D<float4> sortTex;
int maxLevels;
uint ordering; // bool
float strength; // 0..1 cross-fade: lerp(original, sorted, strength)

groupshared uint groupCache[MAX_SIZE];

[numthreads(MAX_THREADS,1,1)]
void SortPass(uint3 gid_l : SV_GroupID,
              uint3 gtid_l : SV_GroupThreadID)
{
    int gid = gid_l.x; // line index
    int gtid = gtid_l.x;
    int ops;
    uint size;
    {
        uint width = viewportSize.x;
        uint height = viewportSize.y;

        size = direction ? width : height; // line length along the major axis
        uint reducedSize = ceil((float)size / 2);

        ops = ceil((float)reducedSize / MAX_THREADS);
    }

    uint preMeta[MAX_OPS];

    {
        for (int t = 0; t < ops; t++)
        {
            int xMeta = (MAX_THREADS * t + gtid);

            int xL = xMeta * 2;
            int xR = xL + 1;

            //get meta (keyed by position/2 along the line, line index)
            uint2 meta = srcMetaTex[uint2(xMeta, gid)];
            uint meta0 = meta.x;
            int startL = (meta0 >> 12) & 0x0FFF;
            int startR = meta0 & 0x0FFF;
            bool useR = (startL & 1) > 0;

            int x = useR ? xR : xL;

            bool isInRange = (startR - startL > 1) && (x <= startR);

            startL = isInRange ? startL : x;
            startR = isInRange ? startR : x;

            preMeta[t] = ((uint)startL << 16) | startR;

            // high 16bit for index, low 16bit for brightness
            groupCache[xL] = (meta.y >> 16) | ((uint)xL << 16);
            groupCache[xR] = (meta.y & 0xFFFF) | ((uint)xR << 16);
        }
    }

    for (uint phase = 0; (phase & 0xFFFF) < (uint)maxLevels; phase++)
    {
        for (phase = (phase << 16) + (phase & 0xFFFF); (uint)(phase >> 16) <= 0x7FFF; phase -= (1 << 16))
        {
            GroupMemoryBarrierWithGroupSync();

            for (int t = 0; t < ops; t++)
            {
                uint metaPacked = preMeta[t];
                int rangeStart = metaPacked >> 16;
                int rangeEnd = metaPacked & 0xFFFF;

                int x = (MAX_THREADS * t + gtid) << 1;

                int useR = rangeStart & 1;
                int posInRange = x - rangeStart + useR;
                int swapIndex = posInRange >> 1;
                int comparatorSize = 1 << (phase >> 16);
                int a = rangeStart + (swapIndex & (comparatorSize - 1)) + floor(swapIndex >> (phase >> 16))
                    * (comparatorSize << 1);

                int b = a + comparatorSize;

                b = b <= rangeEnd ? b : a;

                int block = posInRange >> 1 >> phase;
                int n = rangeEnd - rangeStart + 1;
                int endBlock = n >> (phase + 1);
                bool ascPattern = ((endBlock & 1) == 0) == (ordering != 0);
                bool asc = ((block & 1) == 0) == ascPattern;

                uint val_a = groupCache[a];
                uint val_b = groupCache[b];

                float br_a = f16tof32(val_a & 0xFFFF);
                float br_b = f16tof32(val_b & 0xFFFF);

                bool comp = br_a < br_b;

                uint left = asc == comp ? val_a : val_b;
                uint right = asc == comp ? val_b : val_a;

                groupCache[a] = left;
                groupCache[b] = right;
            }
        }
    }

    for (int t = 0; t < ops; t++)
    {
        int xMeta = (MAX_THREADS * t + gtid);

        int xL = xMeta * 2;
        int xR = xL + 1;

        uint val_a = groupCache[xL];
        uint val_b = groupCache[xR];

        // Clamp gather indices into the valid line range [0, size). A stale index from an
        // uninitialized groupCache slot can appear at a sort-range edge; clamping keeps the read
        // in-bounds (worst case it samples the line's edge pixel instead of garbage).
        uint idx_left = min(val_a >> 16, size - 1);
        uint idx_right = min(val_b >> 16, size - 1);

        bool inA, inB, inL, inR;
        uint2 pos_a = lineTexel(gid, xL, inA);
        uint2 pos_b = lineTexel(gid, xR, inB);
        uint2 pos_left = lineTexel(gid, (int)idx_left, inL);
        uint2 pos_right = lineTexel(gid, (int)idx_right, inR);

        // Only write output texels that are in the major range and inside the view; everything
        // outside is left as the pristine original (it is never written here).
        if (inA && xL < (int)size)
        {
            sortTex[pos_a + viewportMin] = lerp(srcTex[pos_a + viewportMin], srcTex[pos_left + viewportMin], strength);
        }
        if (inB && xR < (int)size)
        {
            sortTex[pos_b + viewportMin] = lerp(srcTex[pos_b + viewportMin], srcTex[pos_right + viewportMin], strength);
        }
    }
}
